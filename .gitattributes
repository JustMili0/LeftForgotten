# Default: normalize everything to LF in the repo
* text=auto eol=lf

# Windows scripts that must stay CRLF
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Never touch binaries
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.jar binary
*.class binary
*.woff binary
*.woff2 binary
*.ttf binary